# Backend Environment Variables

# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=*

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/goalflow

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production
JWT_EXPIRE=30d

# Google Gemini AI
GEMINI_API_KEY=your_gemini_api_key_here

# Firebase Admin SDK
# Get this from Firebase Console > Project Settings > Service Accounts > Generate New Private Key
# Minify the JSON (remove newlines) and paste here
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"your_project_id","private_key_id":"...","private_key":"...","client_email":"...","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token","auth_provider_x509_cert_url":"https://www.googleapis.com/oauth2/v1/certs","client_x509_cert_url":"..."}
